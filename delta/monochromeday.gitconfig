# MonochromeDay for delta (the git diff pager), part of cosmic-monochromeday-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat MonochromeDay theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/monochromeday.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = monochromeday

[delta "monochromeday"]
    light = true
    syntax-theme = MonochromeDay
    navigate = true
    line-numbers = true

    file-style = bold "#5C5C5C"
    file-decoration-style = "#C0C0C0" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#C0C0C0" box
    hunk-header-file-style = "#5C5C5C"
    hunk-header-line-number-style = "#515151"

    minus-style = "#424242" "#F1F1F1"
    minus-emph-style = bold "#E6E6E6" "#424242"
    minus-non-emph-style = "#424242" "#F1F1F1"
    plus-style = "#515151" "#F1F1F1"
    plus-emph-style = bold "#E6E6E6" "#515151"
    plus-non-emph-style = "#515151" "#F1F1F1"
    zero-style = syntax
    whitespace-error-style = "#E6E6E6" "#5C5C5C"

    line-numbers-left-style = "#C0C0C0"
    line-numbers-right-style = "#C0C0C0"
    line-numbers-minus-style = "#424242"
    line-numbers-plus-style = "#515151"
    line-numbers-zero-style = "#818181"

    commit-style = bold "#515151"
    commit-decoration-style = "#C0C0C0" box
    blame-palette = "#E6E6E6 #F1F1F1 #DBDBDB"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#515151"
    merge-conflict-theirs-diff-header-style = bold "#5C5C5C"
